# Normalise line endings in the repository so a Windows checkout and a Linux
# checkout produce the same bytes. Without this, git's `core.autocrlf=true`
# rewrites every file on commit and the diff noise hides real changes.
* text=auto eol=lf

# Vendored Apache-2.0 material is kept byte-identical to upstream.
third_party/osworld/** -text

*.png binary
*.jpg binary
*.pptx binary
*.docx binary
*.xlsx binary

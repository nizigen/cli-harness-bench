# Downloaded OSWorld inputs (re-fetchable, several hundred MB)
.cache/

# Run artifacts: every `run` writes a task sandbox here, and they are large.
# `roundtrip` also writes runs/roundtrip.json — treat that as generated output.
runs/_dry/
runs/_roundtrip/
runs/*/*/
runs/roundtrip.json

# Scratch probes used while porting the grader; not part of the deliverable.
_scratch/

# Project-local software: the unpacked LibreOffice tree and the MSI it came from.
tools/

__pycache__/
*.py[cod]
.pytest_cache/

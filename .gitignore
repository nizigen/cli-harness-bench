# Downloaded OSWorld inputs (re-fetchable, several hundred MB)
.cache/

# Run artifacts: every run writes a task sandbox here, plus screenshots and a
# LibreOffice profile. All of it is regenerable, and the numbers that matter are
# quoted in README.md and docs/report-template.md.
runs/

# Scratch probes used while porting the grader; not part of the deliverable.
_scratch/

# Project-local software: the unpacked LibreOffice tree and the MSI it came from.
tools/

__pycache__/
*.py[cod]
.pytest_cache/
